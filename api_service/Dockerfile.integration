FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/api_service

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY api_service/requirements.txt ./requirements.txt
COPY api_service/requirements-test.txt ./requirements-test.txt
RUN pip install --no-cache-dir \
    -r requirements.txt \
    -r requirements-test.txt

COPY alembic.ini ./alembic.ini
COPY migrations ./migrations
COPY api_service ./api_service

WORKDIR /app/api_service

RUN mkdir -p /app/api_service/logs

CMD ["sh", "-c", "alembic -c /app/alembic.ini upgrade head && pytest -m integration"]
